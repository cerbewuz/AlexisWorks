@model Client

@{
    ViewData["Title"] = "Client Details";
}

<div class="row justify-content-center">
    <div class="col-md-8">
        <div class="card p-4">
            <h5 class="card-title mb-4"><i class="bi bi-person me-2"></i>@Model.Name</h5>
            <dl class="row mb-0">
                <dt class="col-sm-4">First Name</dt>
                <dd class="col-sm-8">@Model.FirstName</dd>

                <dt class="col-sm-4">Middle Name</dt>
                <dd class="col-sm-8">@(string.IsNullOrEmpty(Model.MiddleName) ? "—" : Model.MiddleName)</dd>

                <dt class="col-sm-4">Last Name</dt>
                <dd class="col-sm-8">@Model.LastName</dd>

                <dt class="col-sm-4">Suffix</dt>
                <dd class="col-sm-8">@(string.IsNullOrEmpty(Model.Suffix) ? "—" : Model.Suffix)</dd>

                <dt class="col-sm-4 border-top pt-2">Phone</dt>
                <dd class="col-sm-8 border-top pt-2">+63 @Model.Phone</dd>


                <dt class="col-sm-4 border-top pt-2">Address</dt>
                <dd class="col-sm-8 border-top pt-2">@Model.Address.Replace("|", ", ")</dd>

                <dt class="col-sm-4 border-top pt-2">Total Bookings</dt>
                <dd class="col-sm-8 border-top pt-2">@Model.Bookings.Count</dd>
            </dl>
            <hr />
            <div class="d-flex gap-2">
                <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning"><i class="bi bi-pencil me-1"></i> Edit</a>
                <a asp-action="Index" class="btn btn-outline-secondary">Back to List</a>
            </div>
        </div>
    </div>
</div>
