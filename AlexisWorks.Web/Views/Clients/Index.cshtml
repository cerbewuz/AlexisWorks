@model IEnumerable<Client>

@{
    ViewData["Title"] = "Clients";
}

<div class="page-header">
    <div>
        <p class="text-muted mb-0">Manage your client profiles</p>
    </div>
    <button type="button" class="btn btn-primary" onclick="showGlobalModal('@Url.Action("Create")', 'Add New Client', true)">
        <i class="bi bi-plus-lg me-1"></i> Add Client
    </button>
</div>

<div class="card p-0">
    <div class="card-body p-0">
        <table class="table table-hover mb-0">
            <thead>
                <tr>
                    <th>Name</th>
                    <th>Address</th>
                    <th>Phone</th>
                    <th width="180">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Any())
                {
                    @foreach (var client in Model)
                    {
                        <tr>
                            <td class="fw-semibold">@client.Name</td>
                            <td><span class="text-muted"><i class="bi bi-geo-alt small me-1"></i>@(string.IsNullOrEmpty(client.Address) ? "No address provided" : client.Address.Replace("|", ", "))</span></td>
                            <td>+63 @client.Phone</td>
                            <td>
                                <a asp-action="Details" asp-route-id="@client.Id" class="btn btn-sm btn-outline-info" title="View details">
                                    <i class="bi bi-eye"></i>
                                </a>
                                <button type="button" class="btn btn-sm btn-outline-warning" onclick="openEditModal(@client.Id)" title="Edit">
                                    <i class="bi bi-pencil"></i>
                                </button>
                                <button type="button" class="btn btn-sm btn-outline-danger" onclick="openDeleteModal(@client.Id, '@client.Name')" title="Delete">
                                    <i class="bi bi-trash"></i>
                                </button>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="4" class="text-center text-muted py-4">
                            <i class="bi bi-people fs-1 d-block mb-2"></i>
                            No clients yet. <button type="button" class="btn btn-link p-0" onclick="showGlobalModal('@Url.Action("Create")', 'Add New Client', true)">Add your first client</button>.
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>


<!-- Delete Confirmation Modal -->
<div class="modal fade" id="deleteModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header bg-danger text-white">
                <h5 class="modal-title"><i class="bi bi-exclamation-triangle me-2"></i>Confirm Delete</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <p>Are you sure you want to delete client <strong id="deleteItemName"></strong>?</p>
                <p class="text-danger small mb-0">This will also affect any bookings linked to this client.</p>
            </div>
            <div class="modal-footer">
                <form id="deleteForm" method="post" asp-action="Delete">
                    <input type="hidden" name="id" id="deleteId" />
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-danger">Delete Client</button>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        const deleteModal = new bootstrap.Modal(document.getElementById('deleteModal'));

        function openEditModal(id) {
            showGlobalModal('@Url.Action("Edit")/' + id, 'Edit Client', true);
        }

        function openDeleteModal(id, name) {
            document.getElementById('deleteId').value = id;
            document.getElementById('deleteItemName').innerText = name;
            deleteModal.show();
        }
    </script>
}
