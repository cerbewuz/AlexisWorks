@model Tool

@{
    ViewData["Title"] = "Delete Tool";
}

<div class="row justify-content-center">
    <div class="col-md-6">
        <div class="card p-4 border-danger">
            <h5 class="card-title text-danger mb-4"><i class="bi bi-exclamation-triangle me-2"></i>Confirm Deletion</h5>
            <p>Are you sure you want to remove this tool from inventory?</p>
            <dl class="row mb-3">
                <dt class="col-sm-4">Name</dt>
                <dd class="col-sm-8 fw-semibold">@Model.Name</dd>
                <dt class="col-sm-4">Service</dt>
                <dd class="col-sm-8">@Model.Service.Name</dd>
            </dl>
            <form asp-action="Delete" method="post">
                <input type="hidden" asp-for="Id" />
                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-danger"><i class="bi bi-trash me-1"></i> Delete</button>
                    <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
                </div>
            </form>
        </div>
    </div>
</div>
