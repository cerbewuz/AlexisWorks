@model IEnumerable<Tool>

@{
    ViewData["Title"] = "Inventory";
}

<div class="page-header">
    <div>
        <p class="text-muted mb-0">Manage tools linked to services</p>
    </div>
    <button type="button" class="btn btn-primary" onclick="showGlobalModal('@Url.Action("Create")', 'Add New Tool')">
        <i class="bi bi-plus-lg me-1"></i> Add Tool
    </button>
</div>

<div class="card p-0">
    <div class="card-body p-0">
        <table class="table table-hover mb-0">
            <thead>
                <tr>
                    <th>Tool Name</th>
                    <th>Linked Service</th>
                    <th width="140">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Any())
                {
                    @foreach (var tool in Model)
                    {
                        <tr>
                            <td class="fw-semibold">@tool.Name</td>
                            <td><span class="badge bg-primary bg-opacity-10 text-primary">@tool.Service.Name</span></td>
                            <td>
                                <button type="button" class="btn btn-sm btn-outline-warning" onclick="openEditModal(@tool.Id)" title="Edit">
                                    <i class="bi bi-pencil"></i>
                                </button>
                                <button type="button" class="btn btn-sm btn-outline-danger" onclick="openDeleteModal(@tool.Id, '@tool.Name')" title="Delete">
                                    <i class="bi bi-trash"></i>
                                </button>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="3" class="text-center text-muted py-4">
                            <i class="bi bi-box-seam fs-1 d-block mb-2"></i>
                            No tools yet. <button type="button" class="btn btn-link p-0" onclick="showGlobalModal('@Url.Action("Create")', 'Add New Tool')">Add your first tool</button>.
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>


<!-- Delete Confirmation Modal -->
<div class="modal fade" id="deleteModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header bg-danger text-white">
                <h5 class="modal-title"><i class="bi bi-exclamation-triangle me-2"></i>Confirm Delete</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <p>Are you sure you want to remove tool <strong id="deleteItemName"></strong> from inventory?</p>
                <p class="text-danger small mb-0">This action cannot be undone.</p>
            </div>
            <div class="modal-footer">
                <form id="deleteForm" method="post" asp-action="Delete">
                    <input type="hidden" name="id" id="deleteId" />
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-danger">Remove Tool</button>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        const deleteModal = new bootstrap.Modal(document.getElementById('deleteModal'));

        function openEditModal(id) {
            showGlobalModal('@Url.Action("Edit")/' + id, 'Edit Tool');
        }

        function openDeleteModal(id, name) {
            document.getElementById('deleteId').value = id;
            document.getElementById('deleteItemName').innerText = name;
            deleteModal.show();
        }
    </script>
}
