@model AlexisWorks.Web.ViewModels.ReportsViewModel

@{
    ViewData["Title"] = "Reports";
}

<div class="page-header">
    <div>
        <p class="text-muted mb-0">Billing statements and revenue summary</p>
    </div>
    <form method="get" class="d-flex gap-2 align-items-end">
        <div>
            <label class="form-label small mb-1">Filter by Client</label>
            <select name="clientId" class="form-select form-select-sm" onchange="this.form.submit()">
                <option value="">All Clients</option>
                @foreach (var c in Model.Clients)
                {
                    <option value="@c.Id" selected="@(Model.ClientIdFilter == c.Id)">@c.Name</option>
                }
            </select>
        </div>
    </form>
</div>

<!-- Summary Cards -->
<div class="row g-4 mb-4">
    <div class="col-md-4">
        <div class="card stat-card success p-3">
            <div class="stat-label">Total Paid</div>
            <div class="stat-value text-success">₱@Model.TotalPaid.ToString("N2")</div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card stat-card danger p-3">
            <div class="stat-label">Total Unpaid</div>
            <div class="stat-value text-danger">₱@Model.TotalUnpaid.ToString("N2")</div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card stat-card primary p-3">
            <div class="stat-label">Grand Total</div>
            <div class="stat-value">₱@((Model.TotalPaid + Model.TotalUnpaid).ToString("N2"))</div>
        </div>
    </div>
</div>

<!-- Billing Statement Table -->
<div class="card p-0">
    <div class="card-header bg-white py-3 px-4">
        <h6 class="mb-0 fw-semibold">Billing Statement</h6>
    </div>
    <div class="card-body p-0">
        <table class="table table-hover mb-0">
            <thead>
                <tr>
                    <th>Invoice #</th>
                    <th>Client</th>
                    <th>Service Date</th>
                    <th>Amount</th>
                    <th>Status</th>
                    <th>Payment Date</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Billings.Any())
                {
                    @foreach (var bill in Model.Billings)
                    {
                        <tr>
                            <td>#@bill.Id</td>
                            <td class="fw-semibold">@bill.Booking.Client.Name</td>
                            <td>@bill.Booking.ScheduleDate.ToString("MMM dd, yyyy")</td>
                            <td>₱@bill.AmountDue.ToString("N2")</td>
                            <td>
                                <span class="badge-status @(bill.PaymentStatus == "Paid" ? "badge-paid" : "badge-unpaid")">
                                    @bill.PaymentStatus
                                </span>
                            </td>
                            <td>@(bill.PaymentDate?.ToString("MMM dd, yyyy") ?? "—")</td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="6" class="text-center text-muted py-4">
                            No billing records found.
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
