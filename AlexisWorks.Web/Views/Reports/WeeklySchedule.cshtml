@model IEnumerable<AlexisWorks.Web.Models.Booking>

@{
    ViewData["Title"] = "Calendar";
    var startOfMonth = (DateTime)ViewBag.StartOfMonth;
    var endOfMonth = (DateTime)ViewBag.EndOfMonth;
    var referenceDate = (DateTime)ViewBag.ReferenceDate;
    var startDayOffset = (int)ViewBag.StartDayOffset;
    var totalDaysInMonth = DateTime.DaysInMonth(startOfMonth.Year, startOfMonth.Month);
}

<div class="page-header d-flex justify-content-between align-items-center mb-4">
    <div>
        <h4 class="mb-1 text-dark fw-bold"><i class="bi bi-calendar-event me-2 text-primary"></i>@startOfMonth.ToString("MMMM yyyy")</h4>
        <p class="text-muted mb-0">Monthly Schedule & Bookings</p>
    </div>
    <div class="d-flex align-items-center bg-white rounded-pill shadow-sm p-1">
        <a asp-action="WeeklySchedule" asp-route-date="@startOfMonth.AddMonths(-1).ToString("yyyy-MM-dd")" class="btn btn-sm btn-link text-secondary text-decoration-none px-3" title="Previous Month">
            <i class="bi bi-chevron-left"></i>
        </a>
        <a asp-action="WeeklySchedule" asp-route-date="@DateTime.Today.ToString("yyyy-MM-dd")" class="btn btn-sm btn-primary rounded-pill px-4 fw-medium shadow-sm mx-1">
            Today
        </a>
        <a asp-action="WeeklySchedule" asp-route-date="@startOfMonth.AddMonths(1).ToString("yyyy-MM-dd")" class="btn btn-sm btn-link text-secondary text-decoration-none px-3" title="Next Month">
            <i class="bi bi-chevron-right"></i>
        </a>
    </div>
</div>

<div class="calendar-container shadow-sm rounded-4 overflow-hidden bg-white">
    <!-- Weekday Headers -->
    <div class="calendar-weekdays grid-7">
        <div class="weekday">Sun</div>
        <div class="weekday">Mon</div>
        <div class="weekday">Tue</div>
        <div class="weekday">Wed</div>
        <div class="weekday">Thu</div>
        <div class="weekday">Fri</div>
        <div class="weekday">Sat</div>
    </div>

    <!-- Calendar Days Grid -->
    <div class="calendar-grid grid-7">
        @for (int i = 0; i < startDayOffset; i++)
        {
            <div class="calendar-day padding-day"></div>
        }

        @for (int day = 1; day <= totalDaysInMonth; day++)
        {
            var currentDay = new DateTime(startOfMonth.Year, startOfMonth.Month, day);
            var bookingsForDay = Model.Where(b => b.ScheduleDate.Date == currentDay.Date).OrderBy(b => b.ScheduleDate).ToList();
            var isToday = currentDay.Date == DateTime.Today;

            <div class="calendar-day @(isToday ? "is-today" : "")">
                <div class="day-number-wrapper">
                    <span class="day-number">@day</span>
                </div>
                
                <div class="day-content">
                    @foreach (var booking in bookingsForDay)
                    {
                        <a asp-controller="Bookings" asp-action="Details" asp-route-id="@booking.Id" class="booking-dot-capsule shadow-sm" title="@booking.Client.Name - @booking.ScheduleDate.ToString("h:mm tt")">
                            <span class="dot"></span>
                            <span class="client-name text-truncate">@booking.Client.Name</span>
                        </a>
                    }
                </div>
            </div>
        }

        @* Fill remaining cells to keep grid aligned *@
        @{
            int totalCells = startDayOffset + totalDaysInMonth;
            int remainingCells = (7 - (totalCells % 7)) % 7;
        }
        @for (int i = 0; i < remainingCells; i++)
        {
            <div class="calendar-day padding-day"></div>
        }
    </div>
</div>
