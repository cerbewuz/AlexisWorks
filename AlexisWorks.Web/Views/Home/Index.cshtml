@model AlexisWorks.Web.ViewModels.DashboardViewModel

@{
    ViewData["Title"] = "Dashboard";
}

<!-- Stats Cards -->
<div class="row g-4 mb-4">
    <div class="col-md-3">
        <div class="card stat-card primary p-3">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <div class="stat-label">Total Clients</div>
                    <div class="stat-value">@Model.TotalClients</div>
                </div>
                <i class="bi bi-people stat-icon text-primary"></i>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card stat-card success p-3">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <div class="stat-label">Total Bookings</div>
                    <div class="stat-value">@Model.TotalBookings</div>
                </div>
                <i class="bi bi-calendar-check stat-icon text-success"></i>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card stat-card warning p-3">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <div class="stat-label">Unpaid Bills</div>
                    <div class="stat-value">@Model.UnpaidBillings</div>
                </div>
                <i class="bi bi-exclamation-circle stat-icon text-warning"></i>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card stat-card danger p-3">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <div class="stat-label">Total Revenue</div>
                    <div class="stat-value">₱@Model.TotalRevenue.ToString("N0")</div>
                </div>
                <i class="bi bi-currency-dollar stat-icon text-danger"></i>
            </div>
        </div>
    </div>
</div>

<div class="row g-4">
    <!-- Recent Bookings -->
    <div class="col-md-7">
        <div class="card p-0">
            <div class="card-header bg-white d-flex justify-content-between align-items-center py-3 px-4">
                <h6 class="mb-0 fw-semibold">Recent Bookings</h6>
                <a asp-controller="Bookings" asp-action="Index" class="btn btn-sm btn-outline-primary">View All</a>
            </div>
            <div class="card-body p-0">
                <table class="table table-hover mb-0">
                    <thead>
                        <tr>
                            <th>Client</th>
                            <th>Date</th>
                            <th>Amount</th>
                            <th>Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.RecentBookings.Any())
                        {
                            @foreach (var b in Model.RecentBookings)
                            {
                                <tr>
                                    <td>@b.Client.Name</td>
                                    <td>@b.ScheduleDate.ToString("MMM dd, yyyy h:mm tt")</td>
                                    <td>₱@b.TotalAmount.ToString("N2")</td>
                                    <td><span class="badge-status badge-confirmed">@b.Status</span></td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr><td colspan="4" class="text-center text-muted py-4">No bookings yet.</td></tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- Unpaid Bills -->
    <div class="col-md-5">
        <div class="card p-0">
            <div class="card-header bg-white d-flex justify-content-between align-items-center py-3 px-4">
                <h6 class="mb-0 fw-semibold">Unpaid Bills</h6>
                <a asp-controller="Billings" asp-action="Index" asp-route-status="Unpaid" class="btn btn-sm btn-outline-warning">View All</a>
            </div>
            <div class="card-body p-0">
                <table class="table table-hover mb-0">
                    <thead>
                        <tr>
                            <th>Client</th>
                            <th>Amount</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.UnpaidBills.Any())
                        {
                            @foreach (var bill in Model.UnpaidBills)
                            {
                                <tr>
                                    <td>@bill.Booking.Client.Name</td>
                                    <td class="text-danger fw-semibold">₱@bill.AmountDue.ToString("N2")</td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr><td colspan="2" class="text-center text-muted py-4">All bills are paid! 🎉</td></tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
