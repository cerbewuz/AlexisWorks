@model Service

<form asp-action="Edit" method="post">
    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
    <input type="hidden" asp-for="Id" />

    <div class="mb-3">
        <label asp-for="Name" class="form-label">Service Name</label>
        <input asp-for="Name" class="form-control" />
        <span asp-validation-for="Name" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="HourlyRate" class="form-label">Hourly Rate (₱)</label>
        <input asp-for="HourlyRate" class="form-control" type="number" step="0.01" min="0" />
        <span asp-validation-for="HourlyRate" class="text-danger"></span>
    </div>

    <div class="d-flex justify-content-end gap-2 border-top pt-3">
        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
        <button type="submit" class="btn btn-primary"><i class="bi bi-check-lg me-1"></i> Update</button>
    </div>
</form>

<script>
    // Re-bind validation for dynamically loaded content
    $.validator.unobtrusive.parse('form');
</script>
