@model AlexisWorks.Web.ViewModels.BillingListViewModel

@{
    ViewData["Title"] = "Billing";
}

<div class="page-header">
    <div>
        <p class="text-muted mb-0">Process payments for completed bookings</p>
    </div>
    <div class="d-flex gap-2">
        <a asp-action="Index" class="btn @(Model.StatusFilter == null ? "btn-primary" : "btn-outline-primary") btn-sm">All</a>
        <a asp-action="Index" asp-route-status="Unpaid" class="btn @(Model.StatusFilter == "Unpaid" ? "btn-warning" : "btn-outline-warning") btn-sm">Unpaid</a>
        <a asp-action="Index" asp-route-status="Paid" class="btn @(Model.StatusFilter == "Paid" ? "btn-success" : "btn-outline-success") btn-sm">Paid</a>
    </div>
</div>

<div class="card p-0">
    <div class="card-body p-0">
        <table class="table table-hover mb-0">
            <thead>
                <tr>
                    <th>Invoice #</th>
                    <th>Client</th>
                    <th>Booking Date</th>
                    <th>Amount Due</th>
                    <th>Status</th>
                    <th>Payment Date</th>
                    <th width="160">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Billings.Any())
                {
                    @foreach (var bill in Model.Billings)
                    {
                        <tr>
                            <td>#@bill.Id</td>
                            <td class="fw-semibold">@bill.Booking.Client.Name</td>
                            <td>@bill.Booking.ScheduleDate.ToString("MMM dd, yyyy")</td>
                            <td>₱@bill.AmountDue.ToString("N2")</td>
                            <td>
                                <span class="badge-status @(bill.PaymentStatus == "Paid" ? "badge-paid" : "badge-unpaid")">
                                    @bill.PaymentStatus
                                </span>
                            </td>
                            <td>@(bill.PaymentDate?.ToString("MMM dd, yyyy h:mm tt") ?? "—")</td>
                            <td>
                                @if (bill.PaymentStatus == "Unpaid")
                                {
                                    <button type="button" class="btn btn-sm btn-success" onclick="openPaymentModal(@bill.Id)">
                                        <i class="bi bi-credit-card me-1"></i> Process Payment
                                    </button>
                                }
                                else
                                {
                                    <span class="text-muted small"><i class="bi bi-check-circle-fill text-success"></i> Complete</span>
                                }
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="7" class="text-center text-muted py-4">
                            <i class="bi bi-credit-card fs-1 d-block mb-2"></i>
                            No invoices found.
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<!-- Payment Modal Structure -->
<div class="modal fade" id="paymentModal" tabindex="-1" aria-labelledby="paymentModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header border-0 pb-0">
                <h5 class="modal-title" id="paymentModalLabel">Process Payment</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body" id="modalBody">
                <div class="text-center py-4">
                    <div class="spinner-border text-primary" role="status">
                        <span class="visually-hidden">Loading...</span>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        const paymentModal = new bootstrap.Modal(document.getElementById('paymentModal'));

        function openPaymentModal(id) {
            document.getElementById('modalBody').innerHTML = '<div class="text-center py-4"><div class="spinner-border text-primary" role="status"></div></div>';
            paymentModal.show();
            
            fetch('@Url.Action("ProcessPaymentSummary")/' + id)
                .then(response => response.text())
                .then(html => {
                    document.getElementById('modalBody').innerHTML = html;
                })
                .catch(err => {
                    console.error('Error loading modal:', err);
                    document.getElementById('modalBody').innerHTML = '<div class="alert alert-danger">Error loading content.</div>';
                });
        }
    </script>
}
