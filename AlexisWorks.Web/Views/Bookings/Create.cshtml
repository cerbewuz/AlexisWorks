@model AlexisWorks.Web.ViewModels.BookingCreateViewModel
@{
    bool isModal = Context.Request.Headers["X-Requested-With"] == "XMLHttpRequest" || 
                   Context.Request.Query["isModal"] == "true";
    ViewData["Title"] = "New Booking";
}

@if (!isModal)
{
    <div class="row justify-content-center">
        <div class="col-md-10">
            <div class="card p-4">
                <h5 class="card-title mb-4"><i class="bi bi-calendar-plus me-2"></i>Create Booking</h5>
                @{ await RenderForm(); }
            </div>
        </div>
    </div>
}
else
{
    await RenderForm();
    <script>
        // Initialize Unobtrusive Validation for the dynamic content
        if (typeof $.validator !== 'undefined' && typeof $.validator.unobtrusive !== 'undefined') {
            $.validator.unobtrusive.parse('#bookingForm');
        }
        
        // Re-attach add line item logic for modal
        initLineItems();
    </script>
}

@{
    async Task RenderForm()
    {
        <form asp-action="Create" method="post" id="bookingForm">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <div class="row mb-4">
                <div class="col-md-6 mb-3">
                    <label asp-for="ClientId" class="form-label font-title">Client</label>
                    <select asp-for="ClientId" asp-items="Model.Clients" class="form-select">
                        <option value="">-- Select Client --</option>
                    </select>
                    <span asp-validation-for="ClientId" class="text-danger small"></span>
                </div>
                <div class="col-md-6 mb-3">
                    <label asp-for="ScheduleDate" class="form-label font-title">Date & Time</label>
                    <input asp-for="ScheduleDate" class="form-control" type="datetime-local" />
                    <span asp-validation-for="ScheduleDate" class="text-danger small"></span>
                </div>
            </div>

            <h6 class="fw-bold mb-3 border-bottom pb-2"><i class="bi bi-list-check me-1"></i> Service Line Items</h6>
            <div id="lineItemsContainer">
                @for (int i = 0; i < Model.LineItems.Count; i++)
                {
                    <div class="row g-2 mb-3 line-item align-items-end">
                        <div class="col-md-7">
                            <label class="form-label small text-muted">Service</label>
                            <select name="LineItems[@i].ServiceId" class="form-select">
                                <option value="">-- Select Service --</option>
                                @foreach (var svc in Model.Services)
                                {
                                    <option value="@svc.Value" selected="@(svc.Value == Model.LineItems[i].ServiceId.ToString())">@svc.Text</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-3">
                            <label class="form-label small text-muted">Hours</label>
                            <input name="LineItems[@i].HoursRendered" type="number" step="0.25" min="0.25" value="@Model.LineItems[i].HoursRendered" class="form-control" />
                        </div>
                        <div class="col-md-2 text-end">
                            @if (i > 0)
                            {
                                <button type="button" class="btn btn-outline-danger w-100" onclick="this.closest('.line-item').remove()">
                                    <i class="bi bi-x"></i>
                                </button>
                            }
                        </div>
                    </div>
                }
            </div>

            <button type="button" class="btn btn-link p-0 mb-4" id="addLineItem">
                <i class="bi bi-plus-circle me-1"></i> Add Another Service
            </button>

            <div class="d-flex justify-content-end gap-2 border-top pt-3 mt-2">
                @if (isModal)
                {
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary fw-bold px-4">
                        <i class="bi bi-calendar-check me-1"></i> Confirm Booking
                    </button>
                }
                else
                {
                    <button type="submit" class="btn btn-primary btn-lg">
                        <i class="bi bi-check-lg me-1"></i> Create Booking & Generate Invoice
                    </button>
                    <a asp-action="Index" class="btn btn-outline-secondary btn-lg">Cancel</a>
                }
            </div>
        </form>
    }
}

<script>
    function initLineItems() {
        const addBtn = document.getElementById('addLineItem');
        if (!addBtn || addBtn.getAttribute('data-init')) return;
        addBtn.setAttribute('data-init', 'true');

        addBtn.addEventListener('click', function () {
            const container = document.getElementById('lineItemsContainer');
            const index = container.querySelectorAll('.line-item').length;
            const firstSelect = container.querySelector('select[name^="LineItems[0].ServiceId"]');
            if (!firstSelect) return;
            const servicesOptions = firstSelect.innerHTML;

            const html = `
                <div class="row g-2 mb-3 line-item align-items-end">
                    <div class="col-md-7">
                        <label class="form-label small text-muted">Service</label>
                        <select name="LineItems[${index}].ServiceId" class="form-select">
                            ${servicesOptions}
                        </select>
                    </div>
                    <div class="col-md-3">
                        <label class="form-label small text-muted">Hours</label>
                        <input name="LineItems[${index}].HoursRendered" type="number" step="0.25" min="0.25" value="1" class="form-control" />
                    </div>
                    <div class="col-md-2 text-end">
                        <button type="button" class="btn btn-outline-danger w-100" onclick="this.closest('.line-item').remove()">
                            <i class="bi bi-x"></i>
                        </button>
                    </div>
                </div>`;
            container.insertAdjacentHTML('beforeend', html);
        });
    }

    @if (!isModal) {
        @:document.addEventListener('DOMContentLoaded', initLineItems);
    }
</script>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
