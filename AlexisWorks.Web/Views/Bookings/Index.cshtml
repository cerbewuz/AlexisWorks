@model IEnumerable<Booking>

@{
    ViewData["Title"] = "Bookings";
}

<div class="page-header">
    <div>
        <p class="text-muted mb-0">View and create service bookings</p>
    </div>
    <button type="button" class="btn btn-primary" onclick="showGlobalModal('@Url.Action("Create")', 'New Booking', true)">
        <i class="bi bi-plus-lg me-1"></i> New Booking
    </button>
</div>

<div class="card p-0">
    <div class="card-body p-0">
        <table class="table table-hover mb-0">
            <thead>
                <tr>
                    <th>#</th>
                    <th>Client</th>
                    <th>Schedule</th>
                    <th>Total</th>
                    <th>Status</th>
                    <th>Payment</th>
                    <th width="140">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Any())
                {
                    @foreach (var b in Model)
                    {
                        <tr>
                            <td>@b.Id</td>
                            <td class="fw-semibold">@b.Client.Name</td>
                            <td>@b.ScheduleDate.ToString("MMM dd, yyyy h:mm tt")</td>
                            <td>₱@b.TotalAmount.ToString("N2")</td>
                            <td><span class="badge-status badge-confirmed">@b.Status</span></td>
                            <td>
                                @if (b.Billing != null)
                                {
                                    <span class="badge-status @(b.Billing.PaymentStatus == "Paid" ? "badge-paid" : "badge-unpaid")">
                                        @b.Billing.PaymentStatus
                                    </span>
                                }
                            </td>
                            <td>
                                <a asp-action="Details" asp-route-id="@b.Id" class="btn btn-sm btn-outline-info" title="View details"><i class="bi bi-eye"></i></a>
                                <button type="button" class="btn btn-sm btn-outline-danger" onclick="openDeleteModal(@b.Id, '@b.Client.Name', '@b.ScheduleDate.ToString("MMM dd")')" title="Delete">
                                    <i class="bi bi-trash"></i>
                                </button>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="7" class="text-center text-muted py-4">
                            <i class="bi bi-calendar-check fs-1 d-block mb-2"></i>
                            No bookings yet. <button type="button" class="btn btn-link p-0" onclick="showGlobalModal('@Url.Action("Create")', 'New Booking', true)">Create your first booking</button>.
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<!-- Delete Confirmation Modal -->
<div class="modal fade" id="deleteModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header bg-danger text-white">
                <h5 class="modal-title"><i class="bi bi-exclamation-triangle me-2"></i>Confirm Delete</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <p>Are you sure you want to delete booking <strong>#<span id="deleteIdText"></span></strong> for <strong id="deleteItemName"></strong> on <span id="deleteItemDate"></span>?</p>
                <p class="text-danger small mb-0">This will also remove the associated invoice.</p>
            </div>
            <div class="modal-footer">
                <form id="deleteForm" method="post" asp-action="Delete">
                    <input type="hidden" name="id" id="deleteId" />
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-danger">Delete Booking</button>
                </form>
            </div>
        </div>
    </div>
</div>


@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        const deleteModal = new bootstrap.Modal(document.getElementById('deleteModal'));

        function openDeleteModal(id, client, date) {
            document.getElementById('deleteId').value = id;
            document.getElementById('deleteIdText').innerText = id;
            document.getElementById('deleteItemName').innerText = client;
            document.getElementById('deleteItemDate').innerText = date;
            deleteModal.show();
        }
    </script>
}
