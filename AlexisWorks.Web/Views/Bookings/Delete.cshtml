@model Booking

@{
    ViewData["Title"] = "Delete Booking";
}

<div class="row justify-content-center">
    <div class="col-md-6">
        <div class="card p-4 border-danger">
            <h5 class="card-title text-danger mb-4"><i class="bi bi-exclamation-triangle me-2"></i>Confirm Deletion</h5>
            <p>Are you sure you want to delete this booking? The associated invoice will also be deleted.</p>
            <dl class="row mb-3">
                <dt class="col-sm-4">Booking #</dt>
                <dd class="col-sm-8 fw-semibold">@Model.Id</dd>
                <dt class="col-sm-4">Client</dt>
                <dd class="col-sm-8">@Model.Client.Name</dd>
                <dt class="col-sm-4">Date</dt>
                <dd class="col-sm-8">@Model.ScheduleDate.ToString("MMM dd, yyyy h:mm tt")</dd>
                <dt class="col-sm-4">Total</dt>
                <dd class="col-sm-8">₱@Model.TotalAmount.ToString("N2")</dd>
            </dl>
            <form asp-action="Delete" method="post">
                <input type="hidden" asp-for="Id" />
                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-danger"><i class="bi bi-trash me-1"></i> Delete</button>
                    <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
                </div>
            </form>
        </div>
    </div>
</div>
