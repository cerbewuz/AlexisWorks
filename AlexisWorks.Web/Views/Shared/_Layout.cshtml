<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - AlexisWorks</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/site.css" />
</head>
<body>
    <div class="d-flex">
        <!-- Sidebar -->
        <nav class="sidebar d-flex flex-column flex-shrink-0 px-2 py-3">
            <div class="sidebar-brand text-center">
                <span class="text-uppercase">AlexisWorks</span>
            </div>
            <ul class="nav nav-pills flex-column mb-auto">
                <li class="nav-item">
                    <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Home" ? "active" : "")"
                       asp-controller="Home" asp-action="Index">
                        <i class="bi bi-speedometer2 me-2"></i> Dashboard
                    </a>
                </li>
                <li class="nav-item position-relative">
                    <a class="nav-link w-100 @(ViewContext.RouteData.Values["controller"]?.ToString() == "Clients" ? "active" : "")"
                       asp-controller="Clients" asp-action="Index" style="padding-right: 3rem;">
                        <i class="bi bi-people me-2"></i> Clients
                    </a>
                    <button type="button" class="btn btn-sm btn-link text-muted position-absolute end-0 top-50 translate-middle-y me-2" onclick="showGlobalModal('@Url.Action("Create", "Clients")', 'Add New Client')" style="z-index: 2;">
                        <i class="bi bi-plus-circle"></i>
                    </button>
                </li>
                <li class="nav-item position-relative">
                    <a class="nav-link w-100 @(ViewContext.RouteData.Values["controller"]?.ToString() == "Services" ? "active" : "")"
                       asp-controller="Services" asp-action="Index" style="padding-right: 3rem;">
                        <i class="bi bi-gear me-2"></i> Services
                    </a>
                    <button type="button" class="btn btn-sm btn-link text-muted position-absolute end-0 top-50 translate-middle-y me-2" onclick="showGlobalModal('@Url.Action("Create", "Services")', 'Add New Service')" style="z-index: 2;">
                        <i class="bi bi-plus-circle"></i>
                    </button>
                </li>
                <li class="nav-item position-relative">
                    <a class="nav-link w-100 @(ViewContext.RouteData.Values["controller"]?.ToString() == "Tools" ? "active" : "")"
                       asp-controller="Tools" asp-action="Index" style="padding-right: 3rem;">
                        <i class="bi bi-box-seam me-2"></i> Inventory
                    </a>
                    <button type="button" class="btn btn-sm btn-link text-muted position-absolute end-0 top-50 translate-middle-y me-2" onclick="showGlobalModal('@Url.Action("Create", "Tools")', 'Add New Tool')" style="z-index: 2;">
                        <i class="bi bi-plus-circle"></i>
                    </button>
                </li>
                <li class="nav-item position-relative">
                    <a class="nav-link w-100 @(ViewContext.RouteData.Values["controller"]?.ToString() == "Bookings" ? "active" : "")"
                       asp-controller="Bookings" asp-action="Index" style="padding-right: 3rem;">
                        <i class="bi bi-calendar-check me-2"></i> Bookings
                    </a>
                    <button type="button" class="btn btn-sm btn-link text-muted position-absolute end-0 top-50 translate-middle-y me-2" onclick="showGlobalModal('@Url.Action("Create", "Bookings")', 'New Booking')" style="z-index: 2;">
                        <i class="bi bi-plus-circle"></i>
                    </button>
                </li>
                <li class="nav-item">
                    <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Billings" ? "active" : "")"
                       asp-controller="Billings" asp-action="Index">
                        <i class="bi bi-credit-card me-2"></i> Billing
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Reports" && ViewContext.RouteData.Values["action"]?.ToString() == "Index" ? "active" : "")"
                       asp-controller="Reports" asp-action="Index">
                        <i class="bi bi-bar-chart-line me-2"></i> Reports
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link @(ViewContext.RouteData.Values["action"]?.ToString() == "WeeklySchedule" ? "active" : "")"
                       asp-controller="Reports" asp-action="WeeklySchedule">
                        <i class="bi bi-calendar3 me-2"></i> Weekly Schedule
                    </a>
                </li>
            </ul>
        </nav>

        <!-- Main Content -->
        <div class="main-content flex-grow-1">
            <header class="top-bar d-flex align-items-center justify-content-between px-4 py-2">
                <h4 class="mb-0">@ViewData["Title"]</h4>
                <span class="text-muted small">@DateTime.Now.ToString("dddd, MMMM dd, yyyy")</span>
            </header>
            <main class="p-4">
                @if (TempData["Success"] != null)
                {
                    <div class="alert alert-success alert-dismissible fade show" role="alert">
                        @TempData["Success"]
                        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                    </div>
                }
                @if (TempData["Error"] != null)
                {
                    <div class="alert alert-danger alert-dismissible fade show" role="alert">
                        @TempData["Error"]
                        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                    </div>
                }
                @RenderBody()
            </main>
        </div>
    </div>

    <!-- Global Modal Placeholder -->
    <div class="modal fade" id="globalModal" tabindex="-1" aria-labelledby="globalModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header bg-light">
                    <h5 class="modal-title font-title" id="globalModalLabel">Form</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body" id="globalModalBody">
                    <div class="text-center py-4">
                        <div class="spinner-border text-primary" role="status"></div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
